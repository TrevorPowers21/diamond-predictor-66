# Same Supabase project as the coach app — copy the values from the root
# repo's .env (VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe PUBLISHABLE key only — never the secret key here, this is a
# client-side bundle. Test-mode (pk_test_...) while building/testing.
VITE_STRIPE_PUBLISHABLE_KEY=
